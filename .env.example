# ============================================
# VitisTrust Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ============================================

# ===== ROOTSTOCK / RSK (Asset Layer — EVM) =====
# RPC (testnet public: https://public-node.testnet.rsk.co)
RSK_RPC_URL=https://public-node.testnet.rsk.co
# Contrato VitisRegistry desplegado (scripts/deploy_rsk.py o Forge)
RSK_CONTRACT_ADDRESS=0x...
# Clave del wallet que actúa como oráculo en el contrato
RSK_PRIVATE_KEY=0x...
# Opcional: forzar chain id (testnet=31, mainnet=30)
# RSK_CHAIN_ID=31
RSK_NETWORK=rsk-testnet
ROOTSTOCK_TIMEOUT_S=120

# ===== HEDERA (Trust Layer) =====
HEDERA_ACCOUNT_ID=0.0.xxxxxx
HEDERA_DER_PRIVATE_KEY=3020...
HEDERA_TOPIC_ID=0.0.xxxxxx

# ===== SATELLITE (proveedor satelital) =====
# SATELLITE_PROVIDER: gee | sentinel | auto (default: auto -> GEE si está
# configurado, sino Sentinel Hub, sino fallback determinista de demo)
SATELLITE_PROVIDER=auto

# --- Google Earth Engine (proveedor primario, Sentinel-2 vía GEE) ---
# https://developers.google.com/earth-engine
GEE_PROJECT_ID=
# JSON completo del service account (inline) O GOOGLE_APPLICATION_CREDENTIALS
GEE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# --- Sentinel Hub (proveedor secundario) ---
# https://services.sentinel-hub.com
SENTINEL_CLIENT_ID=...
SENTINEL_CLIENT_SECRET=...

# ===== AI (Groq) =====
# https://console.groq.com
AI_API_KEY=...
AI_MODEL=llama-3.3-70b-versatile

# ===== IPFS / pinning (evidence) =====
# Si no se configuran, el backend usa CIDs mock (mockcid-...)
# PINNING_PROVIDER_URL=https://api.pinata.cloud/pinning/pinJSONToIPFS
# PINNING_PROVIDER_TOKEN=...
# IPFS_GATEWAY_BASE=https://ipfs.io/ipfs

# ===== API / security =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://vitistrust.vercel.app
ADMIN_API_KEY=
REQUIRE_ADMIN_API_KEY=false
VERIFY_RATE_LIMIT_PER_MINUTE=10
EVIDENCE_INDEX_PATH=backend/data/evidence_index.json
DISPUTES_STORE_PATH=backend/data/disputes.json
ENVIRONMENT=development

# ===== Oráculo — gates de certificación =====
# ALLOW_UNVERIFIED_CERTIFY=true permite certificar aunque falle geolocalización
# o vegetación. SOLO para demos; en producción debe quedar en false.
ALLOW_UNVERIFIED_CERTIFY=false
# REQUIRE_REAL_SATELLITE=true bloquea la certificación si la fuente satelital
# es fallback/demo (no hay proveedor real configurado).
REQUIRE_REAL_SATELLITE=false

# ===== Scoring / disputes (opcionales) =====
# SCORING_MODEL_VERSION=1
# MIN_DISPUTE_BOND=0.01
